# Vatra modpack — the repo IS the game folder (a Forge 1.20.1 instance).
#
# This is an allow-list: everything is ignored unless it's listed below.
# Mods constantly create new cache/data folders; this way none of them ever
# show up as changes. To ship a new top-level folder, add a `!/folder/` line.
#
# Big files (*.jar, *.zip, audio, FancyMenu art) are stored with Git LFS on
# git.boloto.studio — see .gitattributes and .lfsconfig.

# --- Ignore everything at the top level... -----------------------------------
/*

# --- ...except what the pack owns --------------------------------------------
!/.gitignore
!/.gitattributes
!/.lfsconfig
!/README.md
!/README.MD
!/CONTRIBUTING.md

!/mods/
!/config/
!/defaultconfigs/
!/kubejs/
!/customnpcs/
!/resourcepacks/
!/shaderpacks/
!/datapacks/
!/saves/

# First-install defaults. The launcher copies these to options.txt /
# servers.dat only if the player doesn't have them yet, so updates never
# reset someone's keybinds, video settings or server list.
!/options.default.txt
!/servers.default.dat

# --- Worlds -------------------------------------------------------------------
# Only the shipped Tutorial world. NOTE: tracked files are reset on every
# update, so progress made inside Tutorial is wiped when the pack updates.
/saves/*
!/saves/Tutorial/
/saves/Tutorial/session.lock
/saves/Tutorial/level.dat_old
/saves/Tutorial/playerdata/*.dat_old
/saves/Tutorial/stats/
/saves/Tutorial/advancements/

# --- Junk inside the folders we do track ---------------------------------------
# Generated by mods at runtime / per player
/mods/.connector/
/mods/*.disabled
/config/jei/world/
/config/voicechat/username-cache.json
/config/fancymenu/*_cache*/
/kubejs/config/
/kubejs/data/
/kubejs/exported/
/kubejs/probe/
/kubejs/assets/kubejs/textures/item/example_item.png
/kubejs/assets/kubejs/textures/block/example_block.png
/kubejs/client_scripts/example.js
/kubejs/server_scripts/example.js
/kubejs/startup_scripts/example.js
/customnpcs/clones/
/customnpcs/*.dat_old

# Anywhere
*.log
*.log.gz
*.sqlite
*.bak
*.tmp
*~
.DS_Store
Thumbs.db
desktop.ini
